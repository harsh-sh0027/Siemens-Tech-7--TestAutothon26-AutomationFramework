# Copy this file to .env and populate with your values
# .env is GITIGNORED for security — never commit it

# ===== DRIVER CONFIGURATION =====
BROWSER=chromium
IS_MOBILE=false
HEADLESS=false

# ===== APPLICATION URLS =====
GAJAB_BASE_URL=https://stg.gajab.com

# ===== APPIUM CONFIGURATION (MOBILE) =====
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APP_PACKAGE=com.gajab.buyerstore
APP_ACTIVITY=.MainActivity

MOBILE_TARGET=native
ANDROID_PLATFORM_NAME=Android
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=
MOBILE_BROWSER_NAME=Chrome
APP_PATH=./gajab-hackathon-sep4.apk

# ===== TEST CREDENTIALS (SYNTHETIC/DUMMY VALUES) =====
TEST_MOBILE=9999999999
TEST_OTP=TEST_OTP_VALUE
TEST_PIN=MOCK_PIN_VALUE

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=INFO
LOG_DIR=./logs
SCREENSHOTS_DIR=./reports/screenshots

# ===== TIMEOUT CONFIGURATION (SECONDS) =====
EXPLICIT_WAIT_TIMEOUT=10
PAGE_LOAD_TIMEOUT=15
POLL_INTERVAL=0.5
